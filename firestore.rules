rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Project Validation
    function isValidProject(data) {
      return data.keys().hasAll(['userId', 'appName', 'repoUrl', 'status', 'packageName', 'versionName', 'versionCode'])
        && data.userId == request.auth.uid
        && data.appName is string && data.appName.size() <= 100
        && data.packageName is string && data.packageName.size() <= 200
        && data.versionName is string && data.versionName.size() <= 50
        && data.versionCode is string && data.versionCode.size() <= 20
        && data.repoUrl is string && data.repoUrl.size() <= 500
        && data.status is string && data.status in ['draft', 'building', 'completed', 'failed']
        && (
            !("permissions" in data) ||
            (data.permissions is list && data.permissions.size() <= 20 && (data.permissions.size() == 0 || data.permissions[0] is string))
        )
        && ( !("orientation" in data) || (data.orientation is string && data.orientation in ['default', 'portrait', 'landscape']) )
        && ( !("fullscreen" in data) || data.fullscreen is bool )
        && ( !("allowCleartext" in data) || data.allowCleartext is bool )
        && ( !("doubleTapToExit" in data) || data.doubleTapToExit is bool )
        && ( !("askNotificationsOnLaunch" in data) || data.askNotificationsOnLaunch is bool )
        && ( !("dismissedFromMonitor" in data) || data.dismissedFromMonitor is bool )
        && ( !("googleServicesJsonName" in data) || (data.googleServicesJsonName is string && data.googleServicesJsonName.size() <= 200) )
        && ( !("splashBackgroundColor" in data) || (data.splashBackgroundColor is string && data.splashBackgroundColor.size() <= 10) )
        && ( !("splashIconSize" in data) || data.splashIconSize is number )
        && ( !("splashAnimation" in data) || (data.splashAnimation is string && data.splashAnimation in ['none', 'fade', 'scale', 'bounce']) )
        && data.createdAt == request.time
        && ( !("updatedAt" in data) || data.updatedAt == request.time );
    }

    function isValidProjectUpdate(data) {
      return data.userId == existing().userId
        && data.userId == request.auth.uid
        && data.appName is string && data.appName.size() <= 100
        && data.packageName is string && data.packageName.size() <= 200
        && data.versionName is string && data.versionName.size() <= 50
        && data.versionCode is string && data.versionCode.size() <= 20
        && data.repoUrl is string && data.repoUrl.size() <= 500
        && data.status is string && data.status in ['draft', 'building', 'completed', 'failed']
        && (
          !("permissions" in data) ||
          (data.permissions is list && data.permissions.size() <= 20 && (data.permissions.size() == 0 || data.permissions[0] is string))
        )
        && ( !("orientation" in data) || (data.orientation is string && data.orientation in ['default', 'portrait', 'landscape']) )
        && ( !("fullscreen" in data) || data.fullscreen is bool )
        && ( !("allowCleartext" in data) || data.allowCleartext is bool )
        && ( !("doubleTapToExit" in data) || data.doubleTapToExit is bool )
        && ( !("askNotificationsOnLaunch" in data) || data.askNotificationsOnLaunch is bool )
        && ( !("dismissedFromMonitor" in data) || data.dismissedFromMonitor is bool )
        && ( !("googleServicesJsonName" in data) || (data.googleServicesJsonName is string && data.googleServicesJsonName.size() <= 200) )
        && ( !("splashBackgroundColor" in data) || (data.splashBackgroundColor is string && data.splashBackgroundColor.size() <= 10) )
        && ( !("splashIconSize" in data) || data.splashIconSize is number )
        && ( !("splashAnimation" in data) || (data.splashAnimation is string && data.splashAnimation in ['none', 'fade', 'scale', 'bounce']) )
        && ( !("buildId" in data) || (data.buildId is string && data.buildId.size() <= 200) )
        && ( !("buildStatusDetails" in data) || (data.buildStatusDetails is string && data.buildStatusDetails.size() <= 1000) )
        && ( !("logUrl" in data) || (data.logUrl is string && data.logUrl.size() <= 1000) )
        && ( !("buildFailureReason" in data) || (data.buildFailureReason is string && data.buildFailureReason.size() <= 2000) )
        && existing().createdAt == data.createdAt
        && data.updatedAt == request.time;
    }

    function isValidBuild(data) {
      return data.keys().hasAll(['id', 'status', 'versionName', 'versionCode', 'createdAt', 'userId'])
        && data.id is string && data.id.size() <= 200
        && data.userId == request.auth.uid
        && data.status is string && data.status in ['building', 'completed', 'failed']
        && data.versionName is string && data.versionName.size() <= 50
        && data.versionCode is string && data.versionCode.size() <= 20
        && ( !("logUrl" in data) || (data.logUrl is string && data.logUrl.size() <= 1000) )
        && ( !("buildFailureReason" in data) || (data.buildFailureReason is string && data.buildFailureReason.size() <= 2000) )
        && data.createdAt == request.time;
    }

    function isValidBuildUpdate(data) {
      return data.id == existing().id
        && data.userId == existing().userId
        && data.userId == request.auth.uid
        && data.status is string && data.status in ['building', 'completed', 'failed']
        && data.versionName == existing().versionName
        && data.versionCode == existing().versionCode
        && ( !("logUrl" in data) || (data.logUrl is string && data.logUrl.size() <= 1000) )
        && ( !("buildFailureReason" in data) || (data.buildFailureReason is string && data.buildFailureReason.size() <= 2000) )
        && existing().createdAt == data.createdAt
        && ( !("updatedAt" in data) || data.updatedAt == request.time );
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().keys().hasAll(['userId', 'appName', 'repoUrl', 'status', 'createdAt'])
        && incoming().keys().size() <= 25;

      allow update: if isSignedIn() 
        && existing().userId == request.auth.uid
        && isValidProjectUpdate(incoming())
        && (
           incoming().diff(existing()).affectedKeys().hasOnly(['appName', 'repoUrl', 'permissions', 'updatedAt', 'versionName', 'versionCode', 'packageName', 'orientation', 'fullscreen', 'allowCleartext', 'doubleTapToExit', 'askNotificationsOnLaunch', 'dismissedFromMonitor', 'splashBackgroundColor', 'splashIconSize', 'splashAnimation']) ||
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', 'buildId', 'buildStatusDetails', 'logUrl', 'buildFailureReason', 'versionCode'])
        );
      
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      match /builds/{buildId} {
        allow read: if isSignedIn() && existing().userId == request.auth.uid;
        allow list: if isSignedIn() && existing().userId == request.auth.uid;
        
        allow create: if isSignedIn()
          && isValidId(buildId)
          && isValidBuild(incoming());
        
        allow update: if isSignedIn()
          && existing().userId == request.auth.uid
          && isValidBuildUpdate(incoming());
        
        allow delete: if isSignedIn() && existing().userId == request.auth.uid;
      }
    }
  }
}
