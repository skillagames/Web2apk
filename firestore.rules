rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Project Validation
    function isValidProject(data) {
      return data.keys().hasAll(['userId', 'appName', 'repoUrl', 'status', 'packageName', 'versionName', 'versionCode', 'createdAt'])
        && data.userId == request.auth.uid
        && data.appName is string && data.appName.size() <= 200
        && data.packageName is string && data.packageName.size() <= 200
        && data.versionName is string && data.versionName.size() <= 50
        && data.versionCode is string && data.versionCode.size() <= 50
        && data.repoUrl is string && data.repoUrl.size() <= 500
        && data.status is string && data.status in ['draft', 'pending', 'building', 'completed', 'failed']
        && (
            !("permissions" in data) ||
            (data.permissions is list && data.permissions.size() <= 20 && (data.permissions.size() == 0 || data.permissions[0] is string))
        )
        && ( !("orientation" in data) || (data.orientation is string && data.orientation in ['default', 'portrait', 'landscape']) )
        && ( !("fullscreen" in data) || data.fullscreen is bool )
        && ( !("allowCleartext" in data) || data.allowCleartext is bool )
        && ( !("doubleTapToExit" in data) || data.doubleTapToExit is bool )
        && ( !("askNotificationsOnLaunch" in data) || data.askNotificationsOnLaunch is bool )
        && ( !("dismissedFromMonitor" in data) || data.dismissedFromMonitor is bool )
        && ( !("googleServicesJsonName" in data) || (data.googleServicesJsonName == null || (data.googleServicesJsonName is string && data.googleServicesJsonName.size() <= 200)) )
        && ( !("splashBackgroundColor" in data) || (data.splashBackgroundColor == null || (data.splashBackgroundColor is string && data.splashBackgroundColor.size() <= 10)) )
        && ( !("splashIconSize" in data) || (data.splashIconSize == null || data.splashIconSize is number) )
        && ( !("splashAnimation" in data) || (data.splashAnimation == null || (data.splashAnimation is string && data.splashAnimation in ['none', 'fade', 'scale', 'bounce'])) )
        && data.createdAt == request.time
        && ( !("updatedAt" in data) || data.updatedAt == request.time );
    }

    function isValidProjectUpdate(data) {
      return ( !("userId" in data) || (data.userId == existing().userId && data.userId == request.auth.uid) )
        && ( !("appName" in data) || (data.appName is string && data.appName.size() <= 200) )
        && ( !("packageName" in data) || (data.packageName is string && data.packageName.size() <= 200) )
        && ( !("versionName" in data) || (data.versionName is string && data.versionName.size() <= 50) )
        && ( !("versionCode" in data) || (data.versionCode is string && data.versionCode.size() <= 50) )
        && ( !("repoUrl" in data) || (data.repoUrl is string && data.repoUrl.size() <= 500) )
        && ( !("status" in data) || (data.status is string && data.status in ['draft', 'pending', 'building', 'completed', 'failed']) )
        && (
          !("permissions" in data) ||
          (data.permissions is list && data.permissions.size() <= 20 && (data.permissions.size() == 0 || data.permissions[0] is string))
        )
        && ( !("orientation" in data) || (data.orientation is string && data.orientation in ['default', 'portrait', 'landscape']) )
        && ( !("fullscreen" in data) || data.fullscreen is bool )
        && ( !("allowCleartext" in data) || data.allowCleartext is bool )
        && ( !("doubleTapToExit" in data) || data.doubleTapToExit is bool )
        && ( !("askNotificationsOnLaunch" in data) || data.askNotificationsOnLaunch is bool )
        && ( !("dismissedFromMonitor" in data) || data.dismissedFromMonitor is bool )
        && ( !("googleServicesJsonName" in data) || (data.googleServicesJsonName == null || (data.googleServicesJsonName is string && data.googleServicesJsonName.size() <= 200)) )
        && ( !("splashBackgroundColor" in data) || (data.splashBackgroundColor == null || (data.splashBackgroundColor is string && data.splashBackgroundColor.size() <= 10)) )
        && ( !("splashIconSize" in data) || (data.splashIconSize == null || data.splashIconSize is number) )
        && ( !("splashAnimation" in data) || (data.splashAnimation == null || (data.splashAnimation is string && data.splashAnimation in ['none', 'fade', 'scale', 'bounce'])) )
        && ( !("buildId" in data) || (data.buildId is string && data.buildId.size() <= 200) )
        && ( !("buildStatusDetails" in data) || (data.buildStatusDetails is string && data.buildStatusDetails.size() <= 1000) )
        && ( !("logUrl" in data) || (data.logUrl is string && data.logUrl.size() <= 1000) )
        && ( !("buildFailureReason" in data) || (data.buildFailureReason is string && data.buildFailureReason.size() <= 2000) )
        && ( !("createdAt" in data) || data.createdAt == existing().createdAt )
        && ( !("updatedAt" in data) || data.updatedAt == request.time );
    }

    function isValidBuild(data) {
      return data.keys().hasAll(['id', 'status', 'versionName', 'versionCode', 'createdAt', 'userId'])
        && data.id is string && data.id.size() <= 200
        && data.userId == request.auth.uid
        && data.status is string && data.status in ['building', 'completed', 'failed']
        && data.versionName is string && data.versionName.size() <= 50
        && data.versionCode is string && data.versionCode.size() <= 20
        && ( !("logUrl" in data) || (data.logUrl is string && data.logUrl.size() <= 1000) )
        && ( !("buildFailureReason" in data) || (data.buildFailureReason is string && data.buildFailureReason.size() <= 2000) )
        && data.createdAt == request.time;
    }

    function isValidBuildUpdate(data) {
      return data.id == existing().id
        && data.userId == existing().userId
        && data.userId == request.auth.uid
        && data.status is string && data.status in ['building', 'completed', 'failed']
        && data.versionName == existing().versionName
        && data.versionCode == existing().versionCode
        && ( !("logUrl" in data) || (data.logUrl is string && data.logUrl.size() <= 1000) )
        && ( !("buildFailureReason" in data) || (data.buildFailureReason is string && data.buildFailureReason.size() <= 2000) )
        && existing().createdAt == data.createdAt
        && ( !("updatedAt" in data) || data.updatedAt == request.time );
    }

    function isVerified() {
      return isSignedIn();
    }

    match /projects/{projectId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && incoming().userId == request.auth.uid
        && isValidId(projectId);

      allow update: if isSignedIn() 
        && existing().userId == request.auth.uid;
      
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;

      match /builds/{buildId} {
        allow read, list: if isSignedIn() && existing().userId == request.auth.uid;
        
        allow create: if isSignedIn()
          && incoming().userId == request.auth.uid
          && isValidId(buildId);
        
        allow update: if isSignedIn()
          && existing().userId == request.auth.uid;
        
        allow delete: if isSignedIn() && existing().userId == request.auth.uid;
      }
    }
  }
}
