rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Project Validation
    function isValidProject(data) {
      return data.keys().hasAll(['userId', 'appName', 'repoUrl', 'status'])
        && data.userId == request.auth.uid
        && data.appName is string && data.appName.size() <= 100
        && data.repoUrl is string && data.repoUrl.size() <= 500
        && data.status is string && data.status in ['draft', 'building', 'completed', 'failed']
        && (
            !("permissions" in data) ||
            (data.permissions is list && data.permissions.size() <= 20 && (data.permissions.size() == 0 || data.permissions[0] is string))
        )
        && data.createdAt == request.time;
    }

    function isValidProjectUpdate(data) {
      return data.userId == existing().userId
        && data.userId == request.auth.uid
        && data.appName is string && data.appName.size() <= 100
        && data.repoUrl is string && data.repoUrl.size() <= 500
        && data.status is string && data.status in ['draft', 'building', 'completed', 'failed']
        && (
          !("permissions" in data) ||
          (data.permissions is list && data.permissions.size() <= 20 && (data.permissions.size() == 0 || data.permissions[0] is string))
        )
        && existing().createdAt == data.createdAt
        && data.updatedAt == request.time;
    }

    match /projects/{projectId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().keys().hasAll(['userId', 'appName', 'repoUrl', 'status', 'createdAt'])
        && incoming().keys().size() <= 7; // Including optional fields: permissions, updatedAt

      allow update: if isSignedIn() 
        && existing().userId == request.auth.uid
        && isValidProjectUpdate(incoming())
        && (
           incoming().diff(existing()).affectedKeys().hasOnly(['appName', 'repoUrl', 'permissions', 'updatedAt']) ||
           incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        );
      
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
