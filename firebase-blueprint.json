{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "A web app project that will be converted to an APK.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the project."
        },
        "userId": {
          "type": "string",
          "description": "The UID of the user who owns this project."
        },
        "appName": {
          "type": "string",
          "description": "The name of the application."
        },
        "packageName": {
          "type": "string",
          "description": "Android package name (e.g. com.example.app)."
        },
        "versionName": {
          "type": "string",
          "description": "User-visible version string (e.g. 1.0.0)."
        },
        "versionCode": {
          "type": "string",
          "description": "Internal version code (must be an integer string)."
        },
        "repoUrl": {
          "type": "string",
          "description": "The GitHub repository URL."
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Android permissions required (e.g. RECORD_AUDIO, CAMERA)."
        },
        "orientation": {
          "type": "string",
          "enum": ["default", "portrait", "landscape"]
        },
        "fullscreen": {
          "type": "boolean"
        },
        "allowCleartext": {
          "type": "boolean"
        },
        "googleServicesJsonName": {
          "type": "string"
        },
        "splashBackgroundColor": {
          "type": "string",
          "description": "Splash screen background color (hex)."
        },
        "splashIconSize": {
          "type": "number",
          "description": "Splash screen icon size (percentage)."
        },
        "splashAnimation": {
          "type": "string",
          "enum": ["none", "fade", "scale", "bounce"]
        },
        "status": {
          "type": "string",
          "enum": ["draft", "building", "completed", "failed"],
          "description": "The status of the APK build."
        },
        "settingsVersion": {
          "type": "number",
          "description": "Version counter for settings"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "appName", "packageName", "repoUrl", "status"]
    },
    "Build": {
      "title": "Build",
      "description": "A specific build entry in the history.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "status": { "type": "string", "enum": ["building", "completed", "failed"] },
        "versionName": { "type": "string" },
        "versionCode": { "type": "string" },
        "logUrl": { "type": "string" },
        "buildFailureReason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "status", "versionName", "versionCode", "createdAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/Project"
      },
      "description": "Stores user projects."
    },
    "/projects/{projectId}/builds/{buildId}": {
      "schema": {
        "$ref": "#/entities/Build"
      },
      "description": "Build history for a project."
    }
  }
}
